# ── Backend (kopyala → backend/.env) ─────────────────────────
DATABASE_URL="postgresql://KULLANICI@localhost:5432/pettrack"
FRONTEND_ORIGIN=http://localhost:1575

# Docker ile PostgreSQL kullanıyorsanız (backend/docker-compose.yml, port 5433):
# DATABASE_URL="postgresql://pettrack:pettrack@localhost:5433/pettrack"

# İsteğe bağlı — Pati Dostu Gemini entegrasyonu (backend/.env)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_DAILY_REQUESTS=15
# GEMINI_MAX_REQUESTS_PER_MINUTE=4
# GEMINI_MAX_INPUT_CHARS=500
# GEMINI_MAX_OUTPUT_TOKENS=640
# GEMINI_THINKING_BUDGET=0

# ── Frontend (kopyala → frontend/.env) ───────────────────────
NEXT_PUBLIC_API_URL=http://localhost:1571
NEXT_PUBLIC_PY_API_URL=http://localhost:1572

# ── Python API (kopyala → backend/py/.env) ───────────────────
# PORT=1572
# FRONTEND_ORIGIN=http://localhost:1575
# GEMINI_API_KEY=
